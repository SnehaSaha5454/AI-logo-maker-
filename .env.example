# ==============================================================================
# LogoMind AI - Environment Variables Template
# Copy this file to .env and provide your actual credentials.
# ==============================================================================

# Neon PostgreSQL Database Connection URL
# Example: postgresql://username:password@ep-your-db-host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_db_password@your_neon_host.neon.tech/neondb?sslmode=require

# Cloudflare Workers AI Credentials
# Get your Account ID and API Token from Cloudflare Dashboard -> AI -> Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Server Port (Default: 5000)
PORT=5000
